    "loading": {
      "description": "Content wrapper becomes invisible, spinner absolute centered at the same icon size.",
      "focus": "Keeps focus and the tab order — the native disabled attribute is NOT set, only aria-disabled + aria-busy. A button that enters loading while focused must not drop the keyboard user to <body>.",
      "activation": "Blocked by an onClick guard that calls preventDefault + stopPropagation and never forwards to the consumer handler. aria-disabled is semantics only and pointer-events-none is CSS, so neither stops Enter/Space; the browser turns those into click, so one guard covers pointer and keyboard. preventDefault also stops implicit form submission (this component does not set type, so the HTML default is submit)."
    }
  },

  "implementation": {
    "pattern": "CVA + cn + @radix-ui/react-slot",
    "stateOverlay": "Sibling <span> inside button with group-hover/group-active classes. Root needs 'group relative overflow-hidden'.",
    "focusRing": "Separate absolute <span> with border-2, shown on focus-visible only. Uses pointerRef to distinguish mouse/keyboard focus.",
    "loadingStrategy": "Content wrapper gets 'invisible' class, Spinner absolute centered in content area.",
    "domStructure": [
      "button (root: bg, height, radius, border, group relative)",
      "  span (focus ring: absolute, border-2, conditional)",
      "  span (state overlay: absolute inset-0, group-hover/group-active bg)",
      "  span (content wrapper: relative, flex, items-center, justify-center)",
      "    span (loading spinner: absolute, conditional)",
      "    span (inner: flex, gap, items-center)",
      "      {iconLeading}",
      "      span (text with px margin)",
      "      {iconTrailing}"
    ],
