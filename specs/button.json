{
  "component": "Button",
  "description": "Universal intent button. 4 hierarchy levels (primary, secondary, outlined, ghost), 4 sizes, 3 shapes, loading state, and icon slots. Part of the Button system (Button / IconButton / TextButton).",
  "figmaNode": "6648:14947",
  "figmaFileKey": "3ZDIVn83opF9OYSzWYE1iF",

  "props": {
    "hierarchy": {
      "type": "'primary' | 'secondary' | 'outlined' | 'ghost'",
      "default": "primary"
    },
    "size": {
      "type": "'xLarge' | 'large' | 'medium' | 'small'",
      "default": "medium"
    },
    "shape": {
      "type": "'basic' | 'circular' | 'square'",
      "default": "basic"
    },
    "fullWidth": {
      "type": "boolean",
      "default": false,
      "description": "Hug (false) or Fill (true)"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "description": "Inactive state. Sets the native disabled attribute, so the button also leaves the tab order."
    },
    "loading": {
      "type": "boolean",
      "default": false,
      "description": "In-flight state. Shows spinner, hides content and blocks activation, but keeps focus and the tab order (aria-disabled + aria-busy)."
    },
    "iconLeading": {
      "type": "ReactNode",
      "default": null,
      "description": "Leading icon slot. Component handles sizing internally via size variant."
    },
    "iconTrailing": {
      "type": "ReactNode",
      "default": null,
      "description": "Trailing icon slot."
    },
    "asChild": {
      "type": "boolean",
      "default": false,
      "description": "Radix Slot — the child element becomes the root and receives the component styles. The consumer child is wrapped in Radix Slottable, which must stay a top-level child of Slot; that is why this path has no content wrapper (gap moves to the root, and loading cannot hide the child's own content)."
    }
  },

