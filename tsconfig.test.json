{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // 테스트와 계약 검사기는 빌드 산출물·소스를 파일 시스템에서 읽는다.
    // 이 types 를 앱 설정(tsconfig.app.json)에 넣지 않는 이유: 컴포넌트 코드가
    // 실수로 node API 를 쓰는 것을 타입 단계에서 막기 위해서다.
    "types": ["node", "vite/client"]
  },
  // extends 로 상속되는 app 설정의 exclude 를 비운다 — 그것이 바로 이 프로젝트의 대상이다.
  "exclude": [],
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/testing/**/*.ts"]
}
